{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    ".github/scripts/pr-policy-check.mjs",
    "scripts/manifest.ts",
    "scripts/prepare.ts",
    "src/components/*.vue",
    "src/components/*/*.vue",
    "src/contentScripts/index.ts",
    "src/inject/index.ts",
    "vite.config.content.ts",
    "vite.config.inject.ts"
  ],
  "ignoreDependencies": [
    "@iconify/json",
    "uno.css"
  ],
  "ignoreBinaries": ["gh", "xcrun"],
  "rules": {
    "types": "off",
    "enumMembers": "off",
    "exports": "off"
  }
}
