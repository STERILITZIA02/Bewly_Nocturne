{
  "name": "bewly-nocturne",
  "displayName": "Bewly Nocturne",
  "type": "module",
  "version": "0.3.0",
  "packageManager": "pnpm@12.14.0",
  "description": "A personal browser extension for a customized Bilibili experience.",
  "homepage": "https://github.com/STERILITZIA02/Bewly_Nocturne",
  "engines": {
    "node": ">=26.12.1 <27",
    "pnpm": ">=12.14.0 <13"
  },
  "scripts": {
    "build-pack": "pnpm build && pnpm pack:zip",
    "dev": "pnpm run clear && cross-env NODE_ENV=development run-p dev:prepare dev:js dev:inject dev:bg dev:native",
    "dev:prepare": "esno scripts/prepare.ts",
    "dev:js": "pnpm run build:js --mode development",
    "dev:inject": "pnpm run build:inject --mode development",
    "dev:bg": "tsup --watch ./src",
    "dev:native": "vite build --config vite.config.native.ts --mode development",
    "build": "cross-env NODE_ENV=production run-s clear build:prepare build:js build:inject build:bg build:native",
    "build-safari": "cross-env NODE_ENV=production SAFARI=true run-s clear-safari build:prepare build:js build:inject build:bg build:native",
    "build:prepare": "esno scripts/prepare.ts",
    "build:js": "vite build --config vite.config.content.ts",
    "build:inject": "vite build --config vite.config.inject.ts",
    "build:bg": "tsup",
    "build:native": "vite build --config vite.config.native.ts",
    "convert-safari": "xcrun safari-web-extension-converter ./extension-safari --project-location ./extension-safari-macos --macos-only",
    "pack": "cross-env NODE_ENV=production run-p pack:*",
    "pack:zip": "rimraf extension.zip && jszip-cli add extension/* -o ./extension.zip",
    "pack:crx": "crx3 -p extension.pem -o extension.crx -- extension",
    "start:chromium": "node scripts/start-chromium.mjs",
    "clear": "rimraf extension extension.zip extension.crx extension.xml",
    "clear-safari": "rimraf extension-safari extension-safari.zip extension-safari.crx extension-safari.xml",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "typecheck": "vue-tsc",
    "verify:notifications": "esno scripts/verify-notification-fixtures.ts",
    "verify:private-message": "esno scripts/verify-private-message.ts",
    "verify:targeted-fixes": "esno scripts/verify-targeted-fixes.ts",
    "verify:selected-p2": "esno scripts/verify-selected-p2.mjs",
    "verify:color-policy": "esno scripts/verify-color-policy.ts",
    "verify:ui-icons": "node scripts/verify-ui-icons.mjs",
    "verify:style-invalidation": "esno scripts/verify-style-invalidation.ts",
    "verify:licenses": "esno scripts/verify-bundle-licenses.ts",
    "preview:color": "node scripts/serve-color-preview.mjs",
    "preview:neutral": "node scripts/serve-neutral-preview.mjs",
    "preview:border": "node scripts/serve-border-preview.mjs",
    "preview:hierarchy": "node scripts/serve-hierarchy-preview.mjs",
    "preview:moment-reply": "node scripts/serve-moment-reply-preview.mjs",
    "preview:message-composer": "node scripts/serve-message-composer-preview.mjs",
    "preview:user-profile": "node scripts/serve-user-profile-preview.mjs",
    "preview:charts": "node scripts/serve-chart-preview.mjs",
    "test": "run-s verify:targeted-fixes verify:selected-p2 verify:private-message verify:notifications verify:color-policy verify:ui-icons verify:style-invalidation verify:licenses",
    "bench:card-window": "esno scripts/serve-card-window-benchmark.mjs",
    "postinstall": "simple-git-hooks",
    "knip": "knip --treat-config-hints-as-errors",
    "submit": "pnpm submit:chrome",
    "submit:chrome": "publish-extension --chrome-zip ./extension.zip",
    "release": "release-it",
    "preview:progressive-blur": "node scripts/serve-progressive-blur-preview.mjs",
    "preview:capsule": "node scripts/serve-capsule-preview.mjs",
    "build:profile": "cross-env BEWLY_PROFILE_BUILD=1 pnpm build"
  },
  "dependencies": {
    "@types/md5": "^2.3.6",
    "dompurify": "^3.4.17",
    "flv.js": "^1.6.2",
    "hls.js": "^1.7.3",
    "md5": "^2.3.0",
    "mitt": "^3.0.1",
    "pinia": "^4.1.0",
    "qrcode.vue": "^3.11.0",
    "tabbable": "^6.5.0",
    "vue-i18n": "^11.4.16",
    "vue-toastification": "2.0.0-rc.5",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@ffflorian/jszip-cli": "^3.16.12",
    "@iconify/json": "^2.2.546",
    "@iconify/vue": "^5.0.4",
    "@intlify/unplugin-vue-i18n": "^11.2.7",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.5",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^15.0.0",
    "chokidar": "^6.0.0",
    "cross-env": "^10.1.0",
    "crx3": "^2.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "esno": "^4.8.0",
    "fake-indexeddb": "^6.2.6",
    "fs-extra": "^11.4.1",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "kolorist": "^1.8.0",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "publish-browser-extension": "^6.2.0",
    "release-it": "21.1.1",
    "rimraf": "^6.1.3",
    "sass": "^1.106.0",
    "simple-git-hooks": "^2.14.0",
    "terser": "^5.51.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "webextension-polyfill": "^0.12.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  }
}
