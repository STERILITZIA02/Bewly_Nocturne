{
  "plugins": {
    "release-it-pnpm": {
      "publishCommand": "echo 'skipping publish'"
    }
  },
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}"
  },
  "hooks": {
    "before:init": [
      "pnpm run lint",
      "pnpm run typecheck",
      "pnpm test"
    ],
    "after:bump": [
      "pnpm run build",
      "pnpm run pack:zip"
    ],
    "after:release": [
      "gh release upload v${version} extension.zip",
      "pnpm run submit"
    ]
  }
}
