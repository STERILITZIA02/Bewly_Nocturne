{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/client.ts",
    "scripts/manifest.ts",
    "scripts/prepare.ts",
    "scripts/verify-notification-fixtures.ts",
    "scripts/verify-private-message.ts",
    "scripts/verify-targeted-fixes.ts",
    "scripts/verify-selected-p2.mjs",
    "scripts/verify-color-policy.ts",
    "scripts/verify-style-invalidation.ts",
    "scripts/serve-card-window-benchmark.mjs",
    "src/contentScripts/views/Notifications/whisper/experimental/index.ts",
    "src/components/*.vue",
    "src/components/*/*.vue",
    "src/contentScripts/index.ts",
    "src/contentScripts/nativeAppearance.ts",
    "src/inject/index.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "uno.css"
  ],
  "rules": {
    "types": "error",
    "enumMembers": "error",
    "exports": "error"
  }
}
