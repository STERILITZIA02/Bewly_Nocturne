{
  "npm": { "publish": false },
  "git": {
    "commitMessage": "chore: 发布 v${version}",
    "tagName": "v${version}"
  },
  "hooks": {
    "before:init": [
      "pnpm run lint",
      "pnpm run typecheck",
      "pnpm test"
    ],
    "after:bump": [
      "pnpm install --lockfile-only",
      "pnpm run build",
      "pnpm run pack:zip"
    ],
    "after:release": [
      "gh release upload v${version} extension.zip",
      "pnpm run submit"
    ]
  }
}
